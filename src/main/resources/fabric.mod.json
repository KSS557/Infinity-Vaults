{
	"schemaVersion": 1,
	"id": "infinityvaults",
	"version": "${version}",
	"name": "Infinite Vaults",
	"description": "Set up the Vault so that you can open it again after a while. The first item to drop will be the one that was displayed when you opened it.",
	"authors": [
		"KSS557"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/infinity-vaults",
		"sources": "https://github.com/KSS557/Infinity-Vaults"
	},
	"license": "MIT",
	"icon": "assets/infinityvaults/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "net.kss557.InfinityVaults",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "net.kss557.InfinityVaultsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"infinitevaults.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2 <26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}